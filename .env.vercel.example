# Vercel production / preview environment template for PivotIQ
# Paste these keys into Vercel Project Settings -> Environment Variables.
# Do not commit real secrets.

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MAX_TOKENS=50000
OPENROUTER_TIMEOUT_MS=120000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
ADMIN_BYPASS_EMAILS=edward.hardrianto@live.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

NEXT_PUBLIC_APP_URL=https://pivotiq.app

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PivotIQ <contact@pivotiq.app>

REMINDER_CRON_SECRET=replace-with-a-long-random-secret
