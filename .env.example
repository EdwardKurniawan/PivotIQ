# Copy this file to .env.local and fill in your keys

# ── Claude API ────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for local dev, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...

# ── Resend (email delivery for paid reports) ───────────────────────────────────
# Get from: https://resend.com/api-keys
# Verify your sender domain at resend.com/domains first
# During early testing you can send from: onboarding@resend.dev
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PivotIQ <reports@yourdomain.com>

# ── App URL ───────────────────────────────────────────────────────────────────
# Used in Stripe success redirects + email links
# Vercel sets VERCEL_URL automatically; set this manually for .env.local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://your-app.vercel.app

# ── Supabase (accounts, saved reports, milestone progress) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Reminder worker ────────────────────────────────────────────────────────────
REMINDER_CRON_SECRET=choose-a-secret-for-your-cron-caller
