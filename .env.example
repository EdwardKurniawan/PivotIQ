# Copy this file to .env.local and fill in your keys

# ── OpenRouter / LLM ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MAX_TOKENS=50000
OPENROUTER_TIMEOUT_MS=120000

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for local dev, sk_live_... for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Comma-separated emails allowed to bypass checkout for internal testing
ADMIN_BYPASS_EMAILS=founder@yourdomain.com

# ── Resend (email delivery for paid reports) ───────────────────────────────────
# Get from: https://resend.com/api-keys
# Verify your sender domain at resend.com/domains first
# During early testing you can send from: onboarding@resend.dev
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PivotIQ <reports@yourdomain.com>

# ── App URL ───────────────────────────────────────────────────────────────────
# Used in Stripe success redirects + email links
# Vercel sets VERCEL_URL automatically; set this manually for .env.local
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Production: https://your-app.vercel.app

# ── Supabase (accounts, saved reports, milestone progress) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Reminder worker ────────────────────────────────────────────────────────────
REMINDER_CRON_SECRET=choose-a-secret-for-your-cron-caller
